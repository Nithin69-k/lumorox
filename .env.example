# ---- Public (safe to expose, injected into the browser bundle) ----
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon/publishable key>"
VITE_SUPABASE_PROJECT_ID="<project-id>"

# ---- Server-only (never prefixed with VITE_) ----
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon/publishable key>"
SUPABASE_SERVICE_ROLE_KEY="<service role key>"   # optional: admin server operations
TMDB_API_KEY="<themoviedb v3 api key>"
# Alternative to TMDB_API_KEY: the TMDB v4 Read Access Token.
TMDB_ACCESS_TOKEN="<themoviedb v4 read access token>"
LOVABLE_API_KEY="<lovable ai gateway key>"        # optional: /ask + semantic search
OPENAI_API_KEY="<openai key>"                     # optional: embeddings, if used

# ---- Deployment ----
# Canonical site origin used for sitemap.xml / robots.txt.
# Leave unset on Vercel and VERCEL_PROJECT_PRODUCTION_URL is used automatically.
SITE_URL="https://your-domain.com"
